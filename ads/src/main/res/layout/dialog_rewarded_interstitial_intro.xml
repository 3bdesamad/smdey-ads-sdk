<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_ads_loading_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/ads_dialog_padding_h"
    android:paddingVertical="@dimen/ads_dialog_padding_v">

    <!-- Reward Icon in Circular Container -->
    <FrameLayout
        android:id="@+id/ly_icon_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_reward_icon_circle">

        <ImageView
            android:id="@+id/iv_reward_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@string/ads_reward_intro_title"
            android:src="@drawable/ic_reward_gift"
            android:tint="@color/ads_dialog_text_subtitle" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tv_intro_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/ads_reward_intro_title"
        android:textColor="@color/ads_native_headline"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle explaining the action -->
    <TextView
        android:id="@+id/tv_intro_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/ads_reward_intro_subtitle"
        android:textColor="@color/ads_dialog_text_subtitle"
        android:textSize="13sp" />

    <!-- Highlighted Reward Text -->
    <TextView
        android:id="@+id/tv_intro_reward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_reward_highlight"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/ads_native_btn_bg"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Action Buttons: Secondary ('No Thanks') & Primary ('Watch Video') -->
    <LinearLayout
        android:id="@+id/ly_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_secondary"
            android:text="@string/ads_reward_intro_skip"
            android:textAllCaps="false"
            android:textColor="@color/ads_native_btn_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_watch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_native_btn"
            android:text="@string/ads_reward_intro_watch"
            android:textAllCaps="false"
            android:textColor="@color/ads_native_btn_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
