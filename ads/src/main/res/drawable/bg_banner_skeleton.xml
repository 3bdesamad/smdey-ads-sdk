<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Square Block (Left) -->
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="start|center_vertical"
        android:start="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ads_skeleton_bg" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Top Bar -->
    <item
        android:height="12dp"
        android:gravity="top"
        android:start="64dp"
        android:end="12dp"
        android:top="14dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ads_skeleton_bg" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <!-- Bottom Bar -->
    <item
        android:width="140dp"
        android:height="12dp"
        android:gravity="bottom"
        android:start="64dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ads_skeleton_bg" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
