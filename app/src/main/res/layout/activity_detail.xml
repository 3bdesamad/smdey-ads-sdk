<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Toolbar -->
    <include
        android:id="@+id/incToolbar"
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Collapsible Banner Demo"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="This screen demonstrates how a fresh Activity triggers and displays a high-impact Collapsible Banner at the bottom.\n\nWhen loaded, the banner expands upward to capture user engagement, and automatically collapses into a normal 50dp banner without obstructing content."
                android:textColor="#555555"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnReloadDetailBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Reload Collapsible Banner" />

        </LinearLayout>
    </ScrollView>

    <!-- Collapsible Smart Banner View -->
    <com.smdey.ads.views.SmartBannerView
        android:id="@+id/detailSmartBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ads_collapsible="true" />

</LinearLayout>
