<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ActivityMain">

    <include
        android:id="@+id/incToolbar"
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dimen_20"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_main"
                android:fontFamily="@font/quick_sand_bold"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:layout_marginBottom="@dimen/dimen_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInterstitial"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/show_interstitial"
                android:fontFamily="@font/quick_sand_bold"
                android:layout_marginBottom="@dimen/dimen_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRewarded"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/show_rewarded"
                android:fontFamily="@font/quick_sand_bold"
                android:layout_marginBottom="@dimen/dimen_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppOpen"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/show_app_open"
                android:fontFamily="@font/quick_sand_bold"
                android:layout_marginBottom="@dimen/dimen_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSecond"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/open_second_activity"
                android:fontFamily="@font/quick_sand_bold"
                android:layout_marginBottom="@dimen/dimen_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/consent_options"
                android:fontFamily="@font/quick_sand_bold"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_marginBottom="@dimen/dimen_12" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:fontFamily="@font/quick_sand_medium"
                android:textColor="@color/tintColor"
                android:layout_marginTop="@dimen/dimen_16" />

        </LinearLayout>
    </ScrollView>

    <com.smdey.ads.sdk.banner.SmartBannerView
        android:id="@+id/bannerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
