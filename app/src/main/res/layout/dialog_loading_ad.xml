<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="@dimen/dimen_40"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dimen_24"
    android:paddingVertical="@dimen/dimen_32">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/yellow_500"
        style="?android:attr/progressBarStyleLarge" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24"
        android:fontFamily="@font/quick_sand_bold"
        android:gravity="center"
        android:text="@string/loading_ad"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8"
        android:fontFamily="@font/quick_sand_medium"
        android:gravity="center"
        android:text="@string/please_wait"
        android:textColor="@color/tintColor"
        android:textSize="14sp" />

</LinearLayout>