<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Toolbar -->
    <include
        android:id="@+id/incToolbar"
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Standard Normal Banner"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="This screen displays a standard, non-collapsible adaptive banner anchored at the bottom.\n\nNotice that the banner renders cleanly without collapsing animations, matching the fixed standard height."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnOpenSecondNormalBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Open Next Normal Banner Screen" />

        </LinearLayout>
    </ScrollView>

    <!-- Standard Normal Smart Banner View -->
    <com.smdey.ads.views.SmartBannerView
        android:id="@+id/normalSmartBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ads_collapsible="false" />

</LinearLayout>
