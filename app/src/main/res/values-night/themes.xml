<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 DayNight Theme (Dark Mode) -->
    <style name="Theme.AdsSample" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#D0BCFF</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorPrimaryContainer">#4F378B</item>
        <item name="colorOnPrimaryContainer">#EADDFF</item>
        <item name="colorSurface">#1C1B1F</item>
        <item name="colorOnSurface">#E6E1E5</item>
        <item name="android:windowBackground">#121A26</item>
    </style>

    <!-- Material 3 Toolbar Title Appearance (Dark Mode) -->
    <style name="toolbarAppearance" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F3F6FA</item>
    </style>

    <!-- Material 3 Toolbar Overlay Theme (Dark Mode) -->
    <style name="toolbarBackColor" parent="ThemeOverlay.Material3.Dark">
        <item name="android:background">#202631</item>
        <item name="colorOnSurface">#F3F6FA</item>
        <item name="colorOnSurfaceVariant">#F3F6FA</item>
        <item name="android:textColorPrimary">#F3F6FA</item>
        <item name="colorControlNormal">#F3F6FA</item>
    </style>
</resources>
